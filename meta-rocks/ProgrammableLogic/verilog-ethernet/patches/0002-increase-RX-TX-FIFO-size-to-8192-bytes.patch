From df47bb467f99ea9fe800624c010e036b2d4f593a Mon Sep 17 00:00:00 2001
From: Michael Jost <michael.jost@pbl.ee.ethz.ch>
Date: Wed, 6 May 2026 11:18:03 +0200
Subject: [PATCH 2/2] increase RX/TX FIFO size to 8192 bytes

---
 example/KR260/fpga_10g/rtl/fpga_core.v | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/example/KR260/fpga_10g/rtl/fpga_core.v b/example/KR260/fpga_10g/rtl/fpga_core.v
index f9732aa..badbc05 100644
--- a/example/KR260/fpga_10g/rtl/fpga_core.v
+++ b/example/KR260/fpga_10g/rtl/fpga_core.v
@@ -84,9 +84,9 @@ eth_mac_10g_fifo #(
     .ENABLE_PADDING(1),
     .ENABLE_DIC(1),
     .MIN_FRAME_LENGTH(64),
-    .TX_FIFO_DEPTH(4096),
+    .TX_FIFO_DEPTH(8192),
     .TX_FRAME_FIFO(1),
-    .RX_FIFO_DEPTH(4096),
+    .RX_FIFO_DEPTH(8192),
     .RX_FRAME_FIFO(1)
 )
 eth_mac_10g_fifo_inst (
